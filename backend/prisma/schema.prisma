generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserType {
  id    Int    @id @default(autoincrement())
  name  String
  code  String
  users User[]
}

model User {
  id             Int      @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String   @unique
  passwordHash   String
  phone          String?
  imageUrl       String?
  userTypeId     Int
  userType       UserType @relation(fields: [userTypeId], references: [id])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdTickets Ticket[] @relation("TicketCreator")
  assignedTickets Ticket[] @relation("TicketAssignee")
  updatedTickets Ticket[] @relation("TicketUpdater")
  uploads        Attachment[] @relation("Uploader")
  history        TicketHistory[] @relation("Actor")
  infoRequests   InfoRequest[] @relation("RequesterTech")
  infoResponses  InfoResponse[] @relation("Responder")
  reports        Report[]
}

model TicketType {
  id                Int      @id @default(autoincrement())
  name              String
  code              String   @unique
  label             String
  description       String
  defaultPriorityId Int
  defaultPriority   Priority @relation(fields: [defaultPriorityId], references: [id])
  isActive          Boolean  @default(true)
  tickets           Ticket[]
}

model Priority {
  id      Int      @id @default(autoincrement())
  name    String
  code    String   @unique
  label   String
  color   String
  tickets Ticket[]
  types   TicketType[]
}

model Status {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  label     String
  sortOrder Int
  color     String   @default("#9CA3AF")
  tickets   Ticket[]
}

model Ticket {
  id           Int      @id @default(autoincrement())
  code         String?  @unique
  ticketTypeId Int
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  title        String
  description  String
  priorityId   Int
  priority     Priority @relation(fields: [priorityId], references: [id])
  statusId     Int
  status       Status   @relation(fields: [statusId], references: [id])
  createdById  Int
  createdBy    User     @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId Int?
  assignedTo   User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  updatedById  Int?
  updatedBy    User?    @relation("TicketUpdater", fields: [updatedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resolvedAt   DateTime?
  isActive     Boolean  @default(true)
  attachments  Attachment[]
  history      TicketHistory[]
  infoRequests InfoRequest[]
}

model Attachment {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploaderId   Int
  uploader     User     @relation("Uploader", fields: [uploaderId], references: [id])
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  uploadedAt   DateTime @default(now())
}

model TicketHistory {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   Int
  actor     User     @relation("Actor", fields: [actorId], references: [id])
  eventType String
  message   String?
  dataJson  String?
  createdAt DateTime @default(now())
}

model InfoRequest {
  id              Int      @id @default(autoincrement())
  ticketId        Int
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requesterTechId Int
  requesterTech   User     @relation("RequesterTech", fields: [requesterTechId], references: [id])
  message         String
  requestedFields String?
  status          String
  createdAt       DateTime @default(now())
  closedAt        DateTime?
  responses       InfoResponse[]
}

model InfoResponse {
  id            Int      @id @default(autoincrement())
  infoRequestId Int
  infoRequest   InfoRequest @relation(fields: [infoRequestId], references: [id])
  responderId   Int
  responder     User     @relation("Responder", fields: [responderId], references: [id])
  message       String
  createdAt     DateTime @default(now())
}

model Report {
  id          Int      @id @default(autoincrement())
  fileName    String?
  preset      String
  errorMessage String?
  createdAt   DateTime @default(now())
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  rangeStart  DateTime
  rangeEnd    DateTime
  filePath    String?
  mimeType    String?
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
